<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="cesur.dam.inventarioappg1.controllers.MainController"
            prefHeight="400.0" prefWidth="600.0">
    <top>
        <HBox alignment="CENTER" spacing="15.0">
            <Button text="Crear equipo" onAction="#create" />
            <Button text="Volver al login" onAction="#logout" />
        </HBox>
    </top>
    <center>
        <TableView fx:id="table" prefHeight="200.0" prefWidth="200.0">
            <columns>
                <TableColumn fx:id="cId" prefWidth="75.0" text="Id" />
                <TableColumn fx:id="cName" prefWidth="75.0" text="Nombre" />
                <TableColumn fx:id="cCategory" prefWidth="75.0" text="Categoria" />
                <TableColumn fx:id="cAvailability" prefWidth="75.0" text="Disponibilidad" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
        </TableView>
    </center>
</BorderPane>
